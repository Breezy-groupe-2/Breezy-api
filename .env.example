# Copy this file to .env and fill every credential locally.
NODE_ENV=development

MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=

JWT_SECRET=
INTERNAL_SERVICE_TOKEN=

# MongoDB URIs — hostnames must match docker-compose service names.
# auth-service uses auth-db; all other services use post-follow-comment-db.
MONGODB_URI=mongodb://breezy_db_admin:password123@auth-db:27017/breezy_auth?authSource=admin
POST_SERVICE_MONGODB_URI=mongodb://breezy_db_admin:password123@post-follow-comment-db:27017/breezy_posts?authSource=admin
COMMENT_SERVICE_MONGODB_URI=mongodb://breezy_db_admin:password123@post-follow-comment-db:27017/breezy_comments?authSource=admin
FOLLOW_SERVICE_MONGODB_URI=mongodb://breezy_db_admin:password123@post-follow-comment-db:27017/breezy_follows?authSource=admin
FEED_SERVICE_MONGODB_URI=mongodb://breezy_db_admin:password123@post-follow-comment-db:27017/breezy_feed?authSource=admin

JWT_EXPIRE=
AUTH_SERVICE_URL=
POST_SERVICE_URL=http://post-service:3002
COMMENT_SERVICE_URL=
FOLLOW_SERVICE_URL=
FEED_SERVICE_URL=

# Local S3 (MinIO) config
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_URL=

# Host port the API gateway (nginx) is published on. The front-end's
# NEXT_PUBLIC_API_URL must point here. Defaults to 3000 if unset.
API_GATEWAY_PORT=3010

# Optional: Google OAuth client ID (from Google Cloud Console).
# Leave empty to disable "Sign in with Google" - the app runs fine without it.
GOOGLE_CLIENT_ID=
