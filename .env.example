# 🐳 Breezy Microservices Configuration

# Global MongoDB Configuration
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin123

# Auth Service
MONGODB_URI=mongodb://admin:admin123@auth-db:27017/breezy_auth?authSource=admin
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d

# Post Service
POST_SERVICE_MONGODB_URI=mongodb://admin:admin123@post-db:27017/breezy_posts?authSource=admin

# Comment Service
COMMENT_SERVICE_MONGODB_URI=mongodb://admin:admin123@comment-db:27017/breezy_comments?authSource=admin

# Feed Service
FEED_SERVICE_MONGODB_URI=mongodb://admin:admin123@feed-db:27017/breezy_feeds?authSource=admin

# API Gateway Routing (Local development)
AUTH_SERVICE_URL=http://localhost:3001
POST_SERVICE_URL=http://localhost:3002
COMMENT_SERVICE_URL=http://localhost:3003
FEED_SERVICE_URL=http://localhost:3004
