# Copy this file to .env and fill every credential locally.
NODE_ENV=development

MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=

JWT_SECRET=
MONGODB_URI=
POST_SERVICE_MONGODB_URI=
COMMENT_SERVICE_MONGODB_URI=
FOLLOW_SERVICE_MONGODB_URI=
FEED_SERVICE_MONGODB_URI=
PROFILE_SERVICE_MONGODB_URI=

JWT_EXPIRE=
AUTH_SERVICE_URL=
POST_SERVICE_URL=
COMMENT_SERVICE_URL=
FOLLOW_SERVICE_URL=
FEED_SERVICE_URL=

# Local S3 (MinIO) config
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_URL=

# Host port the API gateway (nginx) is published on. The front-end's
# NEXT_PUBLIC_API_URL must point here. Defaults to 3000 if unset.
API_GATEWAY_PORT=3010

# Optional: Google OAuth client ID (from Google Cloud Console).
# Leave empty to disable "Sign in with Google" — the app runs fine without it.
GOOGLE_CLIENT_ID=
